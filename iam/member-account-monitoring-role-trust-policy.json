{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowApprovedAutomationAccount",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::REPLACE_WITH_MANAGEMENT_ACCOUNT_ID:role/DiskMonitoringAutomationRole"
      },
      "Action": "sts:AssumeRole",
      "Condition": {
        "StringEquals": {
          "sts:ExternalId": "REPLACE_WITH_UNIQUE_EXTERNAL_ID"
        }
      }
    }
  ]
}
